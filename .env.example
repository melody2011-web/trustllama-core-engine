# Wallet credentials and RPC endpoint must be created in Replit Secrets.
# Do not put real values in this file.
WALLET_ADDRESS=
WALLET_PRIVATE_KEY=
BSC_RPC_URL=

# Live execution is opt-in and defaults to false.
ENABLE_LIVE_TRADING=false
SLIPPAGE_BPS=100
DEADLINE_SECONDS=120
RECEIPT_TIMEOUT_SECONDS=180
MAX_GAS_LIMIT=700000

# The live runner requires an explicit strategy mode. "disabled" is the
# fail-closed default; choose "ema" only to resume the legacy EMA/RSI strategy.
LIVE_STRATEGY_MODE=disabled

# Reserved VM dual-grid gates. Each bot remains paused unless the global gate,
# its own live gate, its own grid mode, and a fresh authenticated panel approval
# are all present. The workflow definitions deliberately set these to disabled.
TRADING_GRID_BOT_1_ENABLE_LIVE_TRADING=false
TRADING_GRID_BOT_1_STRATEGY_MODE=disabled
TRADING_GRID_BOT_1_CONTROL_PORT=8008
TRADING_GRID_BOT_2_ENABLE_LIVE_TRADING=false
TRADING_GRID_BOT_2_STRATEGY_MODE=disabled
TRADING_GRID_BOT_2_CONTROL_PORT=9000

# Live grid accumulator: XRP and BTC each anchor once, then use five
# 5%-spaced levels at $50/line and no more than $250 of open exposure per asset.
# BUY_IMMEDIATELY_NOW=true consumes level 1 at the current quote once per asset;
# the durable claim prevents another immediate entry after a restart.
# Keep it false until a read-only preflight is complete.
GRID_SYMBOLS=XRP,BTC
TOTAL_GRID_LEVELS=5
PER_LINE_USDT=50.0
GRID_STEP_PERCENT=0.05
BUY_IMMEDIATELY_NOW=false
PROFIT_TARGET_PERCENT=0.05
GRID_MAX_BUDGET_USDT=250
# Backward-compatible aliases, when the matching new variable is absent:
# GRID_LEVELS=5
# GRID_ORDER_USDT=50
# GRID_SPACING_BPS=500
# GRID_TAKE_PROFIT_BPS=500

# EMA crossover + RSI settings. These apply only when LIVE_STRATEGY_MODE=ema.
STRATEGY_FAST_WINDOW=9
STRATEGY_SLOW_WINDOW=21
STRATEGY_RSI_WINDOW=14
STRATEGY_BUY_RSI_MAX=65
STRATEGY_SELL_RSI_MIN=65
STRATEGY_POSITION_BPS=2000
STRATEGY_COOLDOWN_SECONDS=900
STRATEGY_STOP_LOSS_BPS=500
STRATEGY_TAKE_PROFIT_BPS=1000
STRATEGY_MAX_TRADES_PER_DAY=3
# Leave blank to use the stable, wallet-scoped state file under ~/.local/state.
STRATEGY_STATE_FILE=

# Continuous paper tracking. This uses only the public RPC and never broadcasts.
PAPER_POLL_INTERVAL_SECONDS=60
PAPER_RETRY_BASE_SECONDS=5
PAPER_RETRY_MAX_SECONDS=300
PAPER_PRICE_HISTORY_LIMIT=100
PAPER_STARTING_BNB=1
PAPER_STARTING_XRP=0
PAPER_STARTING_BTC=0
# Leave blank to use ~/.local/state/bnb-defi-bot/paper.json.
PAPER_STATE_FILE=