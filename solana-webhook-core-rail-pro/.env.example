# Copy this file to .env for local development. Never commit the real file.
SOLANA_RPC_URL=https://api.mainnet-beta.solana.com
SOLANA_RPC_URLS=
SOLANA_COMMITMENT=confirmed
SOLANA_WATCH_ADDRESSES=
SOLANA_WATCH_SIGNATURES=
WEBHOOK_URL=https://your-service.example.com/webhooks/solana
WEBHOOK_SECRET=replace-with-a-long-random-secret
# The release includes its staging mapping beside this file.
STAGING_DISTRIBUTION_PATH=./staging-webhook-distribution.toml
WEBHOOK_TIMEOUT_SECONDS=10
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_BASE_BACKOFF_SECONDS=2
SOLANA_POLL_INTERVAL_SECONDS=2
SOLANA_SIGNATURE_LIMIT=50
SOLANA_MAX_RPC_CONCURRENCY=16
WEBHOOK_MAX_CONCURRENCY=16
EVENT_QUEUE_SIZE=1000
BLOCK_PROCESSING_LATENCY_WARNING_THRESHOLD_MS=1000
STATE_PATH=./core-rail-state.sqlite3
DEAD_LETTER_MAX_ENTRIES=1000
RECOVERY_BOUNDARY_MAX_ENTRIES=1000
LOG_LEVEL=INFO