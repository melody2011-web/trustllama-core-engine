# Required only when ANNOUNCER_LIVE_SEND=true.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHANNEL_ID=

# Safe default: render announcements and log them, but do not send anything.
ANNOUNCER_LIVE_SEND=false

# Seconds between successful announcements. Four hours is a conservative
# default for a rotating public information stream.
ANNOUNCER_INTERVAL_SECONDS=14400

# Retry controls for transient Telegram/API failures.
ANNOUNCER_MAX_RETRIES=5
ANNOUNCER_RETRY_BASE_SECONDS=5

# Public tokenomics copy used by the isolated announcement stream:
# Supply: 1,000,000,000 TLAMA
# Allocation: 1% developer / 10% automated Web3 game payouts /
#             89% public liquidity pool (LP tokens intended to be burned)
# Approved buy tax: 0.5% | approved sell tax: 1.0%
# Maximum transaction: 0.5% of supply (5,000,000 TLAMA)
# Maximum wallet holding: 1.0% of supply (10,000,000 TLAMA)
#
# These are finalized pre-launch design rules. They are not deployment claims;
# on-chain enforcement requires an independently audited immutable Token-2022
# Transfer Hook and compatible pool adapter.